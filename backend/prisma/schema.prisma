generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model User {
    id                     BigInt            @id @default(autoincrement())
    email                  String            @unique
    password               String?
    googleId               String?           @unique
    firstName              String
    lastName               String
    avatar                 String?
    isOnline               Boolean           @default(false)
    role                   Role              @default(BUYER)
    verificationType       VerificationType?
    verificationId         String?
    isVerified             Boolean           @default(false)
    isActive               Boolean           @default(true)
    refreshToken           String?
    lastLoginAt            DateTime?
    emailVerifyOtp         String?
    emailVerifyOtpExpiry   DateTime?
    passwordResetOtp       String?
    passwordResetOtpExpiry DateTime?
    transactionPin         String?
    createdAt              DateTime          @default(now())
    updatedAt              DateTime          @updatedAt

    store     Store?
    userBanks UserBank[]
    orders    OrderGroup[]
    wallet    UserWallet?

    @@index([email])
    @@index([googleId])
    @@map("users")
}

model Category {
    id          BigInt   @id @default(autoincrement())
    name        String   @unique
    description String?
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    stores   CategoryStorePivot[]
    products Product[]

    @@map("categories")
}

model Market {
    id          BigInt   @id @default(autoincrement())
    name        String   @unique
    description String?
    stateId     BigInt?  @map("state_id")
    url         String?
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    stores Store[]
    state  State?  @relation(fields: [stateId], references: [id], onDelete: SetNull)

    @@map("markets")
}

model Store {
    id          BigInt   @id @default(autoincrement())
    name        String
    description String?
    imageUrl    String?
    ownerId     BigInt   @unique
    marketId    BigInt?
    openDays    Day[]    @default([])
    openingTime String? // "HH:mm" e.g. "09:00"
    closingTime String? // "HH:mm" e.g. "17:30"
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    user       User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    categories CategoryStorePivot[]
    market     Market?              @relation(fields: [marketId], references: [id], onDelete: SetNull)
    products   Product[]
    wallet     SellerWallet?

    @@map("stores")
}

model CategoryStorePivot {
    id         BigInt   @id @default(autoincrement())
    categoryId BigInt
    storeId    BigInt
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

    @@unique([categoryId, storeId])
    @@map("category_store_pivot")
}

model Product {
    id          BigInt   @id @default(autoincrement())
    name        String
    description String?
    price       Decimal  @db.Decimal(12, 2)
    imageUrl    String?
    storeId     BigInt
    isAvailable Boolean  @default(true)
    categoryId  BigInt?
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
    category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
    orders   Order[]

    @@map("products")
}

model Bank {
    id        BigInt   @id @default(autoincrement())
    name      String   @unique
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    userBanks UserBank[]

    @@map("banks")
}

model UserBank {
    id            BigInt   @id @default(autoincrement())
    userId        BigInt
    bankId        BigInt
    accountNumber String
    isSelected    Boolean  @default(false)
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    transactions SellerWalletTransaction[]
    user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
    bank         Bank                      @relation(fields: [bankId], references: [id], onDelete: Cascade)

    @@unique([userId, bankId])
    @@map("user_banks")
}

model OrderPayments {
    id           BigInt        @id @default(autoincrement())
    orderGroupId BigInt
    amount       Decimal       @db.Decimal(12, 2)
    reference    String        @unique
    status       PaymentStatus @default(PENDING)
    provider     String? // e.g., "STRIPE", "PAYSTACK"
    createdAt    DateTime      @default(now())
    updatedAt    DateTime      @updatedAt

    orderGroup OrderGroup @relation(fields: [orderGroupId], references: [id], onDelete: Cascade)

    @@map("payments")
}

model OrderGroup {
    id          BigInt           @id @default(autoincrement())
    refNo       String           @unique
    status      OrderGroupStatus @default(PENDING)
    buyerId     BigInt
    totalAmount Decimal          @db.Decimal(12, 2)
    deliveredAt DateTime? // set when status → DELIVERED; 72h clock starts here
    createdAt   DateTime         @default(now())
    updatedAt   DateTime         @updatedAt

    buyer             User               @relation(fields: [buyerId], references: [id], onDelete: Cascade)
    orders            Order[]
    payments          OrderPayments[]
    walletTransaction WalletTransaction?

    @@index([buyerId])
    @@map("order_groups")
}

model Order {
    id           BigInt      @id @default(autoincrement())
    orderGroupId BigInt
    productId    BigInt?
    quantity     Int
    unitPrice    Decimal     @db.Decimal(12, 2)
    totalPrice   Decimal     @db.Decimal(12, 2)
    status       OrderStatus @default(PENDING)
    createdAt    DateTime    @default(now())
    updatedAt    DateTime    @updatedAt

    orderGroup  OrderGroup         @relation(fields: [orderGroupId], references: [id], onDelete: Cascade)
    product     Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
    escrowEntry SellerEscrowEntry?
    refund      WalletTransaction? // populated only when status → DECLINED

    @@index([orderGroupId])
    @@map("orders")
}

// ─── Seller wallet ────────────────────────────────────────────────────────────

model SellerWallet {
    id               BigInt   @id @default(autoincrement())
    storeId          BigInt   @unique
    escrowBalance    Decimal  @default(0) @db.Decimal(12, 2) // delivered but 72h not yet passed
    availableBalance Decimal  @default(0) @db.Decimal(12, 2) // ready to withdraw
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt

    store         Store                     @relation(fields: [storeId], references: [id], onDelete: Cascade)
    escrowEntries SellerEscrowEntry[]
    transactions  SellerWalletTransaction[]

    @@map("seller_wallets")
}

model SellerWalletTransaction {
    id          BigInt                      @id @default(autoincrement())
    walletId    BigInt
    userBankId  BigInt?
    amount      Decimal                     @db.Decimal(12, 2)
    type        SellerWalletTransactionType
    status      WithdrawalStatus            @default(COMPLETED)
    description String?
    reference   String?                     @unique // External withdrawal reference
    createdAt   DateTime                    @default(now())

    wallet   SellerWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
    userBank UserBank?    @relation(fields: [userBankId], references: [id], onDelete: SetNull)

    @@index([walletId, createdAt(sort: Desc)])
    @@map("seller_wallet_transactions")
}

model SellerEscrowEntry {
    id          BigInt       @id @default(autoincrement())
    walletId    BigInt
    orderId     BigInt       @unique // DB-level duplicate guard — one entry per order
    amount      Decimal      @db.Decimal(12, 2)
    status      EscrowStatus @default(HELD)
    deliveredAt DateTime // copied from OrderGroup.deliveredAt; 72h is measured from here
    releasedAt  DateTime? // set by the background job when funds move to availableBalance
    createdAt   DateTime     @default(now())
    updatedAt   DateTime     @updatedAt

    wallet SellerWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
    order  Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

    @@map("seller_escrow_entries")
}

// ─── Buyer wallet (store credit for refunds on declined orders) ───────────────

model UserWallet {
    id            BigInt   @id @default(autoincrement())
    userId        BigInt   @unique
    creditBalance Decimal  @default(0) @db.Decimal(12, 2)
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
    transactions WalletTransaction[]

    @@map("user_wallets")
}

// for buyers
model WalletTransaction {
    id           BigInt                @id @default(autoincrement())
    walletId     BigInt
    orderId      BigInt?               @unique // REFUND — one refund per declined order
    orderGroupId BigInt?               @unique // PURCHASE_DEDUCTION — one deduction per checkout
    amount       Decimal               @db.Decimal(12, 2)
    type         WalletTransactionType
    description  String?
    createdAt    DateTime              @default(now())

    wallet     UserWallet  @relation(fields: [walletId], references: [id], onDelete: Cascade)
    order      Order?      @relation(fields: [orderId], references: [id], onDelete: Cascade)
    orderGroup OrderGroup? @relation(fields: [orderGroupId], references: [id], onDelete: Cascade)

    @@map("wallet_transactions")
}

model State {
    id        BigInt   @id @default(autoincrement())
    name      String   @unique
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    markets Market[]

    @@map("states")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
    BUYER
    SELLER
    ADMIN
}

enum VerificationType {
    NATIONAL_ID
    INTERNATIONAL_PASSPORT
    DRIVERS_LICENSE
}

enum OrderGroupStatus {
    PENDING
    PAYMENT_CONFIRMED
    SHIPPED
    DELIVERED
    CANCELLED
}

enum OrderStatus {
    PENDING
    CONFIRMED
    READY_FOR_SHIPMENT
    SHIPPED
    DELIVERED
    DECLINED
}

enum EscrowStatus {
    HELD // delivered, 72h not yet passed
    RELEASED // moved to availableBalance by the background job
    REFUNDED
    DISPUTED
}

enum WithdrawalStatus {
    PENDING
    PROCESSING
    COMPLETED
    FAILED
}

enum WalletTransactionType {
    REFUND // credited to buyer when seller declines a paid order
    PURCHASE_DEDUCTION // debited when buyer uses credit on a new order
}

enum SellerWalletTransactionType {
    ESCROW_CREDIT // order delivered → funds enter escrow
    ESCROW_RELEASE // 72h passed → funds move to availableBalance
    WITHDRAWAL // seller withdraws funds
}

enum Day {
    MONDAY
    TUESDAY
    WEDNESDAY
    THURSDAY
    FRIDAY
    SATURDAY
    SUNDAY
}

enum PaymentStatus {
    PENDING
    SUCCESS
    FAILED
    REVERSED
}
