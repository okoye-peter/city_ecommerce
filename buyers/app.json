{
  "expo": {
    "name": "buyers",
    "slug": "buyers",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "buyers",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./src/assets/images/icon.png",
      "bundleIdentifier": "com.okoyedev.buyers"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./src/assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.okoyedev.buyers"
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/images/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/icon.png",
          "backgroundColor": "#ffffff",
          "android": {
            "image": "./src/assets/images/icon.png",
            "imageWidth": 150
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      "@react-native-community/datetimepicker",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cf93d576-1ed0-43f5-8c3c-d03ef6897c4d"
      }
    }
  }
}
